# Placeholder only. Never put real keys in version control.
APP_HOST=127.0.0.1
APP_PORT=8765
# Qwen text LLM only. Copy actual regional/workspace Base URL from Bailian.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_MODEL=qwen-plus
# Voice service reads these keys from local .env; process environment wins.
BREEZE_API_KEY=
BREEZE_VOICE_ID=
VOICE_PORT=8766
# Optional pre-created Fun-ASR hotword vocabulary ID.
ASR_VOCABULARY_ID=


# Agent text provider: qwen or deepseek. ASR remains Bailian.
TEXT_PROVIDER=qwen
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# TTS provider: cosyvoice = Qwen TTS on Bailian; breeze_realtime = Breeze streaming;
# leave empty to use the default BreezeBlue voice.
# QWEN_TTS_VOICE is the cloned-voice id used when TTS_PROVIDER=cosyvoice.
TTS_PROVIDER=
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QWEN_TTS_VOICE=
QWEN_TTS_VOICE_NAME=
