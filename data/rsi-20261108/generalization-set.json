        {"user_input": "老板姓王，执照是他的名字，我这边有他签的授权书。",
         "assert": {"not_contain": ["必须本人", "只能法人", "必须老板本人"], "records_total": 0}},
        {"user_input": "那你先说这次要补哪几样。",
         "assert": {"not_contain": ["联系对象不符", "不再披露"], "records_total": 0}}
      ]
    },
    {
      "id": "G02a",
      "pair": "G02",
      "kind": "intercept",
      "focus": "待确认状态下，敷衍答复不得落成写入",
