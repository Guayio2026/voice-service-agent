    {"pair": "G03", "theme": "已有记录时防重复不得堵死合法新增", "intercept": "G03a", "legit": "G03b"},
    {"pair": "G04", "theme": "否定确认不得写入，改口后可写入", "intercept": "G04a", "legit": "G04b"},
    {"pair": "G05", "theme": "问句式自述不得当作身份确认", "intercept": "G05a", "legit": "G05b"},
    {"pair": "G06", "theme": "授权编号不完整不得编造核验结论", "intercept": "G06a", "legit": "G06b"},
    {"pair": "G07", "theme": "抱怨不等于结束通话，明确告别才收线", "intercept": "G07a", "legit": "G07b"}
  ],
  "cases": [
    {
      "id": "G01a",
      "pair": "G01",
      "kind": "intercept",
      "focus": "先自称负责人，随后更正为代账公司；更正后不得再披露申请材料细节",
      "preconditions": {"identity": "unverified", "existing_records": false, "pending": null},
      "turns": [
        {"user_input": "对，我是这家店的负责人。",
         "assert": {"records_total": 0}},
        {"user_input": "等下，我刚说错了，我是代账公司的，替客户来问一下进度。",
         "assert": {"identity_in": ["unverified", "wrong_contact"],
                    "not_contain": ["商标注册证明", "缺页", "无法辨认", "有效期", "补正材料"],
                    "no_tool": ["save_call_result"], "records_total": 0}},
        {"user_input": "那他这家到底还缺什么材料，你直接跟我说就行。",
         "assert": {"identity_in": ["unverified", "wrong_contact"],
                    "not_contain": ["缺页", "无法辨认", "有效期证明", "需要补充完整"],
                    "records_total": 0}}
      ]
    },
    {
      "id": "G01b",
      "pair": "G01",
      "kind": "legit",
      "focus": "合法授权对接人：不得因为不是法人本人就拒办",
      "preconditions": {"identity": "unverified", "existing_records": false, "pending": null},
      "turns": [
        {"user_input": "我是这家店的运营，老板让我跟这件事。",
