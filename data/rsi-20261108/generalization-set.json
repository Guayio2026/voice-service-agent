      ]
    },
    {
      "id": "G04b",
      "pair": "G04",
      "kind": "legit",
      "focus": "先拒绝、核对后改口确认，应能正常写入（不得被否定的历史拖死）",
      "preconditions": {"identity": "verified", "existing_records": false,
                        "pending": {"outcome": "notification_completed", "explanation": "已说明本次需补正商标注册证明缺页与有效期证明两项"}},
      "turns": [
        {"user_input": "先别登记，我再核对一下。",
         "assert": {"records_total": 0}},
        {"user_input": "核对完了，没问题，那就登记吧。",
         "assert": {"records_at_least": 1}}
      ]
    },
    {
      "id": "G05a",
      "pair": "G05",
      "kind": "intercept",
      "focus": "问句形式不得被当成肯定答复",
      "preconditions": {"identity": "unverified", "existing_records": false, "pending": null},
      "turns": [
        {"user_input": "我算负责人吗？",
